# Charara network credentials - template.
#
# Copy to the robot and keep it root-owned / unreadable by others:
#   sudo install -d -m 0750 -o root -g root /etc/charara
#   sudo install -m 0600 -o root -g root network.env.example /etc/charara/network.env
#   sudoedit /etc/charara/network.env
#
# deploy/host/configure_wifi.sh sources this file (override the path with
# CHARARA_NET_ENV) and deploy/host/configure_vpn.sh reads TS_AUTHKEY from the
# environment - export it or source this file before running that script.
#
# This template is committed; network.env itself is git-ignored.

# Home Wi-Fi the robot should join when it is in range.
SSID="your-home-ssid"
PASSWORD="your-home-wifi-password"

# Tailscale auth key for deploy/host/configure_vpn.sh (optional).
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx
