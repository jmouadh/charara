* text=auto

# Shell scripts must stay LF even when cloned on Windows
*.sh text eol=lf

# Windows entry points stay CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# IAR / CubeMX project files: keep the vendor's CRLF
*.ewp text eol=crlf
*.eww text eol=crlf
*.ewd text eol=crlf
*.ewt text eol=crlf
*.icf text eol=crlf
*.ioc text eol=lf

# Binary assets
*.pdf binary
*.lib binary
*.hex binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary

# GitHub language stats (Linguist): the ST HAL / CMSIS tree under Drivers/ is
# vendor code downloaded from ST, and the EWARM startup file is CubeMX
# generated. Neither says anything about the shape of this project, so keep
# them out of the language bar. The custom drivers next to them
# (STEPPERS_/ENCODERS_/OLED_MouadhJeridi) are ours and stay counted.
STM32/Firmware/Drivers/CMSIS/** linguist-vendored
STM32/Firmware/Drivers/STM32F7xx_HAL_Driver/** linguist-vendored
STM32/Firmware/EWARM/startup_*.s linguist-generated
