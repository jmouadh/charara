# Copy to docker/.env to override the compose defaults (all optional).
# Docker Compose reads this file automatically when run from docker/.

# Robot link -------------------------------------------------------------
#ROBOT_TRANSPORT=i2c        # i2c (default) or mock
#I2C_BUS=1
#I2C_ADDRESS=0x0A
#I2C_RETRIES=5

# Field ------------------------------------------------------------------
#FIELD_WIDTH_MM=3000
#FIELD_HEIGHT_MM=2000

# Planning defaults ------------------------------------------------------
#DEFAULT_SPEED_MM_S=200
#DEFAULT_ACCEL_MM_S2=400
#DEFAULT_DECEL_MM_S2=500
#DEFAULT_LAT_ACCEL_MM_S2=300
#DEFAULT_GOTO_STEP_MM=250
#DEFAULT_FIT_TOL_MM=8
#DEFAULT_INFLATION_MM=180
#DEFAULT_GRID_MM=50

# Telemetry / executor ---------------------------------------------------
#TELEMETRY_HZ=10
#DEADMAN_MS=1500

# Sensor fusion (Docs/09; all optional, defaults ON) ---------------------
# Absent hardware degrades to wheel-only automatically (no faults).
#CAMERA_POSES=1             # accept ArUco robot poses from the camera
#IMU=1                      # MPU6050 sampler (i2c transport only)
#IMU_YAW_AXIS=auto          # yaw axis: auto = detect from gravity (facing down -> -z)
#GYRO_STREAM=1              # forward yaw rate to the board (fw >= 3.3)
#STREAMING_EXEC=1           # streaming follower backend (fw >= 3.4, Docs/10); 0 = segment backend
#REANCHOR=1                 # idle-only, camera-gated SET_POSE corrections
#START_POSE=1               # adopt the team match start when the board reads (0,0,0)
#IMU_BUS=6                  # MPU6050 bus: i2c6 on GPIO22/23 (dtoverlay=i2c6)
#IMU_ADDRESS=0x68
#IMU_RATE_HZ=100
#GYRO_STREAM_HZ=50
#CAMERA_SIGMA_XY_MM=10
#CAMERA_SIGMA_THETA_DEG=3
#GYRO_SIGMA_DEG_S=1.5
#GYRO_SCALE=1.0             # spin-calibrated MPU6050 scale (Docs/09 9.3)
#ODOM_TRACK_MM=170          # localization wheel track (board register 7)

# Remote access over Tailscale (the vpn service) -------------------------
# Generate an auth key at https://login.tailscale.com/admin/settings/keys
# and paste it below: the stack then serves the console to your whole
# tailnet at http://<TS_HOSTNAME>:8080 (MagicDNS) or http://<tailnet-ip>:8080.
# Without a key the vpn container starts but stays offline.
#TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx
#TS_HOSTNAME=charara
#TS_EXTRA_ARGS=--advertise-tags=tag:charara

# Brain ------------------------------------------------------------------
# Name (or path) of the strategy the brain plays; saved strategies live in
# the shared strategies volume (STRATEGY_DIR=/data/strategies in docker).
#STRATEGY=main
